        "tuesday": "7:00 PM ET",
        "friday": "6:00 PM ET"
      },
      "timezone": "America/New_York",
      "platforms": ["instagram", "tiktok", "youtube_shorts"]
    },
    "reclaim": {
      "posts_per_week": 2,
